// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model CompanyProfile {
  id                String    @id @default(cuid())
  userId            String    @unique
  name              String
  orgNr             String
  address           String
  phone             String
  email             String
  mvaRegisteredFrom DateTime?
  defaultCurrency   String    @default("NOK")
  ibanOrAccount     String
  bic               String?
  bankName          String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id     String @id @default(cuid())
  userId String

  invoiceNumber String
  invoiceDate   DateTime
  dueDate       DateTime
  periodStart   DateTime?
  periodEnd     DateTime?
  projectRef    String?

  issuerName    String
  issuerOrgNr   String
  issuerAddress String
  issuerPhone   String
  issuerEmail   String

  clientName    String
  clientOrgNr   String?
  clientAddress String
  clientEmail   String?

  billingType BillingType
  fixedPrice  Decimal?
  currency    String      @default("NOK")
  vatRate     Int         @default(25)

  ibanOrAccount String
  bic           String?
  bankName      String

  mvaRegisteredFrom DateTime?

  status InvoiceStatus @default(DRAFT)

  lineItems WorkLogItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, invoiceNumber])
}

model WorkLogItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  date        DateTime
  description String
  hours       Decimal
  rate        Decimal
}

enum BillingType {
  HOURLY
  FIXED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
}

/// Tracks a user's Stripe subscription status. One row per user —
/// created/updated by the Stripe webhook whenever a checkout
/// completes or a subscription's status changes (renewed, canceled,
/// payment failed, etc). This is the single source of truth the
/// free-tier gate checks before letting someone past 3 invoices.
model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  stripeCustomerId     String    @unique
  stripeSubscriptionId String?   @unique
  status               String // "active", "canceled", "past_due", "incomplete", etc.
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}
